{
  "name": "parkingos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "smoke:ratelimit": "node check-rate-limit.js",
    "smoke:ratelimit:auto": "node -e \"process.env.RL_AUTOSTART_SERVER='true'; require('./check-rate-limit.js')\"",
    "smoke:ratelimit:junit": "node -e \"process.env.RL_REPORT_FORMAT='junit'; require('./check-rate-limit.js')\"",
    "smoke:ratelimit:strict": "node -e \"process.env.RL_REPORT_FORMAT='junit'; process.env.RL_FAIL_ON_SKIPPED='true'; require('./check-rate-limit.js')\"",
    "smoke:ratelimit:strict:auto": "node -e \"process.env.RL_REPORT_FORMAT='junit'; process.env.RL_FAIL_ON_SKIPPED='true'; process.env.RL_AUTOSTART_SERVER='true'; require('./check-rate-limit.js')\"",
    "smoke:business": "node check-business-flow.js",
    "smoke:business:auto": "node -e \"process.env.BF_AUTOSTART_SERVER='true'; require('./check-business-flow.js')\"",
    "smoke:business:junit:auto": "node -e \"process.env.BF_AUTOSTART_SERVER='true'; process.env.BF_REPORT_FORMAT='junit'; require('./check-business-flow.js')\"",
    "smoke:sse": "node check-realtime-sse.js",
    "smoke:sse:auto": "node -e \"process.env.SSE_AUTOSTART_SERVER='true'; require('./check-realtime-sse.js')\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "nodemailer": "^8.0.3",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.8.0",
    "stripe": "^20.4.1",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.18.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^7.5.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
