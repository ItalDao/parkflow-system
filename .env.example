# ParkingOS - Environment Variables Example
# Copy this file to .env and adjust values for your local environment.

# PostgreSQL connection string
# Example: postgresql://postgres:1234@localhost:5432/parking_db?schema=public
DATABASE_URL=

# Access token secret (JWT). Use a long random string in production.
JWT_SECRET=

# Refresh token secret (JWT). Use a different long random string.
JWT_REFRESH_SECRET=

# Public app URL used for redirects and absolute links.
# Example local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Runtime mode (optional in local dev)
# NODE_ENV=development

# Rate limiter backend: memory (current) | redis (planned fallback to memory until provider is wired)
RATE_LIMIT_BACKEND=memory

# Required when RATE_LIMIT_BACKEND=redis
REDIS_URL=

# Salt used to hash client IP for audit logs
AUDIT_IP_SALT=

# Salt used to hash public API keys at rest
API_KEY_SALT=

# Optional demo API key used by /api/seed
SEED_API_KEY=pkos_demo_local_1234567890

# Secret header for cron maintenance endpoints (x-cron-secret)
CRON_SECRET=

# SMTP configuration for transactional email notifications
EMAIL_PROVIDER=smtp
EMAIL_FROM="ParkingOS <no-reply@parkingos.local>"

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ParkingOS <no-reply@parkingos.local>"

# SendGrid (optional when EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=

# Mailgun (optional when EMAIL_PROVIDER=mailgun)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=
MAILGUN_REGION=us

# Stripe checkout and webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
